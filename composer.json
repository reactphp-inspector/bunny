{
  "name": "react-inspector/bunny",
  "description": "\ud83d\uddc4\ufe0f Open Telemetry bunny/bunny auto instrumentation",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-opentelemetry": "^1.1.3",
    "bunny/bunny": "0.6.0-alpha.3 || 0.6.0-alpha.4",
    "nyholm/psr7": "^1.8.2",
    "open-telemetry/api": "^1.10.0",
    "open-telemetry/context": "^1.5.0",
    "open-telemetry/sdk": "^1.15.0",
    "open-telemetry/sem-conv": "^1.38.0",
    "symfony/http-client": "^8.1.2"
  },
  "require-dev": {
    "wyrihaximus/async-test-utilities": "^13.5.2",
    "wyrihaximus/makefiles": "^0.14.2"
  },
  "autoload": {
    "psr-4": {
      "ReactInspector\\Bunny\\": "src"
    },
    "files": [
      "_register.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "ReactInspector\\Tests\\Bunny\\": "tests"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupol/composer-packages": true,
      "ergebnis/composer-normalize": true,
      "icanhazstring/composer-unused": true,
      "infection/extension-installer": true,
      "mindplay/composer-locator": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "tbachert/spi": true,
      "wyrihaximus/broadcast": true,
      "wyrihaximus/makefiles": true,
      "wyrihaximus/test-utilities": true
    },
    "platform": {
      "php": "8.4.13"
    },
    "sort-packages": true
  },
  "scripts": {
    "post-install-cmd": [
      "composer normalize || true",
      "make on-install-or-update || true"
    ],
    "post-update-cmd": [
      "make on-install-or-update || true"
    ]
  }
}
